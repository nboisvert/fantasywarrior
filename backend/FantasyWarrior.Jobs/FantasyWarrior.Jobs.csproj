<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FantasyWarrior.Core\FantasyWarrior.Core.csproj" />
    <ProjectReference Include="..\FantasyWarrior.Data\FantasyWarrior.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- HTML parsing for FantasySP (no public RSS feed exists for it, unlike
         Rotowire — see NewsSyncJob/FantasySpScraper). -->
    <PackageReference Include="HtmlAgilityPack" Version="1.11.*" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- CopyToPublishDirectory="Never": Jobs is only ever run locally/in CI via
         `dotnet run` (daily-jobs.yml), never published on its own. Publish-time
         copy has to be off, though, because FantasyWarrior.Api now references
         this project (for SimAdvanceJob) and a P2P reference's CopyToOutputDirectory
         items flow into the referencing project's publish output; without this,
         `dotnet publish` on the Api collides with its own appsettings.json at the
         same relative path (NETSDK1152). -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Update="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Condition="Exists('appsettings.Local.json')" />
  </ItemGroup>

</Project>