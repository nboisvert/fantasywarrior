<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FantasyWarrior.Core\FantasyWarrior.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- HTML parsing for FantasySP (no public RSS feed exists for it, unlike
         Rotowire — see NewsSyncJob/FantasySpScraper). -->
    <PackageReference Include="Google.Cloud.Firestore.Admin.V1" Version="3.19.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.*" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
